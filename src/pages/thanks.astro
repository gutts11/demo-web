---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Thank You | TORVIX">
  <Header />
  
  <main class="flex-grow pt-32 pb-24 bg-slate-900 min-h-screen flex items-center justify-center">
    <div class="max-w-3xl mx-auto px-6 text-center reveal">
      <h1 class="text-5xl md:text-6xl font-extrabold text-white tracking-tight mb-6 font-serif">Thank you!</h1>
      <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-10">
        We will get back to you shortly.
      </p>
      <a href="/" class="inline-block px-8 py-4 bg-accent text-white font-medium rounded-none border border-accent hover:bg-white hover:text-slate-900 hover:border-white transition-all duration-500 ease-in-out text-lg shadow-lg hover:-translate-y-1">
        Return to Homepage
      </a>
    </div>
  </main>
  
  <Footer />
</Layout>
