---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/Contact.astro';
import { MapPin, Phone, Mail, Instagram } from 'lucide-astro';
---

<Layout title="Contact | TORVIX">
  <Header />
  
  <main class="flex-grow pt-32 pb-24 bg-slate-50 min-h-screen">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center reveal mb-16">
        <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-6">Get in Touch</h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          Ready to start your next project? Our team is here to answer your questions and bring your vision to life.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 bg-white p-8 md:p-12 rounded-none shadow-sm border border-slate-200 reveal delay-200">
        
        <!-- Left Side: Contact Info -->
        <div class="flex flex-col justify-center">
          <h2 class="text-3xl font-bold text-slate-900 mb-8">Contact Information</h2>
          
          <div class="space-y-8">
            <div class="flex items-start gap-5 group">
              <div class="w-12 h-12 bg-accent-soft rounded-none flex items-center justify-center text-accent flex-shrink-0 group-hover:bg-accent group-hover:text-white transition-colors duration-300">
                <Phone class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Phone</p>
                <a href="tel:+14374329595" class="text-xl font-medium text-slate-900 hover:text-accent transition-colors">
                  +1 (437) 432-9595
                </a>
              </div>
            </div>

            <div class="flex items-start gap-5 group">
              <div class="w-12 h-12 bg-accent-soft rounded-none flex items-center justify-center text-accent flex-shrink-0 group-hover:bg-accent group-hover:text-white transition-colors duration-300">
                <Mail class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Email</p>
                <a href="mailto:torvixca@gmail.com" class="text-xl font-medium text-slate-900 hover:text-accent transition-colors">
                  torvixca@gmail.com
                </a>
              </div>
            </div>

            <div class="flex items-start gap-5 group">
              <div class="w-12 h-12 bg-accent-soft rounded-none flex items-center justify-center text-accent flex-shrink-0 group-hover:bg-accent group-hover:text-white transition-colors duration-300">
                <MapPin class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Address</p>
                <p class="text-xl font-medium text-slate-900 leading-relaxed">
                  36 Mannar Dr,<br />Markham, ON L6C 0Z3
                </p>
              </div>
            </div>

            <div class="flex items-start gap-5 group">
              <div class="w-12 h-12 bg-accent-soft rounded-none flex items-center justify-center text-accent flex-shrink-0 group-hover:bg-accent group-hover:text-white transition-colors duration-300">
                <Instagram class="w-5 h-5" />
              </div>
              <div>
                <p class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-1">Social</p>
                <a href="https://www.instagram.com/torvixbuilding" target="_blank" rel="noopener noreferrer" class="text-xl font-medium text-slate-900 hover:text-accent transition-colors">
                  @torvixbuilding
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Google Map -->
        <div class="rounded-none overflow-hidden h-96 w-full shadow-inner bg-slate-100 border border-slate-200">
          <iframe 
            src="https://maps.google.com/maps?q=36+Mannar+Dr,+Markham,+ON+L6C+0Z3&t=&z=15&ie=UTF8&iwloc=&output=embed" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Office Location Map"
          ></iframe>
        </div>

      </div>
    </div>
    
    <!-- Duplicate Quote Form Section -->
    <div class="mt-12 border-t border-slate-200">
      <ContactForm />
    </div>
  </main>
  
  <Footer />
</Layout>
