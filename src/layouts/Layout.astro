---
import '@fontsource/inter';
import '@fontsource/playfair-display';
import '../styles/global.css';
import IntroPopup from '../components/IntroPopup.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<title>{title || 'Torvix | Luxury Construction & Custom Home Renovation in Toronto'}</title>
		<meta name="description" content="Premium construction, home renovation, and commercial remodeling services in Toronto, Canada. Torvix delivers luxury craftsmanship, structural repairs, and custom building solutions." />
		<meta name="keywords" content="construction company Toronto, custom home builder, luxury renovation Canada, bathroom remodeling, kitchen remodeling, structural repair, commercial contractors GTA, home additions, basement finishing, Torvix" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href="https://torvix.ca" />
		
		<!-- Open Graph / Social Media -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://torvix.ca" />
		<meta property="og:title" content={title || 'Torvix | Luxury Construction & Custom Home Renovation in Toronto'} />
		<meta property="og:description" content="Premium construction, home renovation, and commercial remodeling services in Toronto, Canada. Torvix delivers luxury craftsmanship, structural repairs, and custom building solutions." />

		<link rel="preconnect" href="https://ipnxlabghrlsehafkdio.supabase.co" />
		<link rel="preconnect" href="https://res.cloudinary.com" />
	</head>
	<body class="antialiased min-h-screen flex flex-col font-sans selection:bg-accent selection:text-white bg-[#f9f8f6] text-[#1a1a1a]">
		<IntroPopup />
		<slot />
		
		<script>
			if (typeof window !== 'undefined' && typeof document !== 'undefined') {
				// Intersection Observer for scroll animations
				document.addEventListener('DOMContentLoaded', () => {
					const observerOptions = {
						root: null,
						rootMargin: '0px',
						threshold: 0.15
					};

					const observer = new IntersectionObserver((entries, observer) => {
						entries.forEach(entry => {
							if (entry.isIntersecting) {
								entry.target.classList.add('active');
								observer.unobserve(entry.target);
							}
						});
					}, observerOptions);

					const revealElements = document.querySelectorAll('.reveal');
					revealElements.forEach(el => observer.observe(el));

					// Visual CMS Edit Mode & Supabase Persistence Logic
					const initCMS = async () => {
						const { createClient } = await import('https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm');
						const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
						const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
						const supabase = createClient(supabaseUrl, supabaseKey);

						// 1. Generate Stable Unique Keys for DOM Elements
						const getScopePrefix = (el) => el.closest('footer') ? '/global-footer' : window.location.pathname;

						document.querySelectorAll('img:not(.logo)').forEach((img) => {
							if (img.closest('header')) return;
							
							const currentKey = img.getAttribute('data-cms-key');
							if (!currentKey) {
								const src = img.getAttribute('src');
								if (src) {
									const scope = getScopePrefix(img);
									img.setAttribute('data-cms-key', 'cms_img_' + scope + '_' + decodeURI(src));
								}
							}
						});

						document.querySelectorAll('h1, h2, h3, h4, p, span').forEach((el) => {
							if (el.closest('header')) return;
							
							const currentKey = el.getAttribute('data-cms-key');
							if (!currentKey) {
								const rawText = el.innerHTML.trim().substring(0, 30);
								if (rawText.length > 0) {
									const scope = getScopePrefix(el);
									const b64 = btoa(encodeURIComponent(rawText)).replace(/=/g, '');
									el.setAttribute('data-cms-key', 'cms_txt_' + scope + '_' + b64);
								}
							}
						});

						// 2. Global Hydration: Fetch from Supabase for ALL users
						let data = null;
						try {
							const cached = sessionStorage.getItem('torvix_cms_cache');
							if (cached) data = JSON.parse(cached);
						} catch(e) {}

						if (!data) {
							const { data: dbData, error } = await supabase.from('torvix_cms').select('*');
							if (error) { 
								console.error('Supabase fetch error:', error); 
								return; 
							}
							if (dbData) {
								data = dbData;
								try {
									sessionStorage.setItem('torvix_cms_cache', JSON.stringify(dbData));
								} catch(e) {}
							}
						}

						const updatedKeys = new Set();

						if (data) {
							data.forEach(row => {
								try {
									const el = document.querySelector(`[data-cms-key="${CSS.escape(row.key)}"]`);
									if (el) {
										if (el.tagName === 'IMG') {
											const optimizedUrl = row.value.replace('/upload/', '/upload/w_1200,f_auto,q_auto/');
											if (el instanceof HTMLImageElement) {
												el.src = optimizedUrl;
											}
											el.removeAttribute('srcset');
											el.classList.remove('opacity-0');
											el.classList.add('opacity-100');
											updatedKeys.add(row.key);
										} else {
											el.textContent = row.value;
										}
									}
								} catch(e) {}
							});

							// Dynamic Service Dropdown Population
							const servicesSet = new Set();
							data.forEach(row => {
								const match = row.key.match(/cms_img_\/services\/([^\/_]+)/);
								if (match && match[1]) {
									servicesSet.add(match[1]);
								}
							});
							
							const serviceSelect = document.getElementById('service');
							if (serviceSelect && servicesSet.size > 0) {
								serviceSelect.innerHTML = '<option value="" disabled selected>Select a service</option>';
								Array.from(servicesSet).sort().forEach(service => {
									const capitalized = service.charAt(0).toUpperCase() + service.slice(1);
									const option = document.createElement('option');
									option.value = service.toLowerCase();
									option.textContent = capitalized;
									serviceSelect.appendChild(option);
								});
								const optionOther = document.createElement('option');
								optionOther.value = 'other';
								optionOther.textContent = 'Other';
								serviceSelect.appendChild(optionOther);
							}
						}

						// 3. Fallback: Reveal all images that weren't in the database
						document.querySelectorAll('img:not(.logo)').forEach((img) => {
							if (img.closest('header')) return;
							const key = img.getAttribute('data-cms-key');
							if (key && !updatedKeys.has(key)) {
								img.classList.remove('opacity-0');
								img.classList.add('opacity-100');
							}
						});
					};
					initCMS().catch(err => console.error('CMS initialization failed:', err));
				});
			}
		</script>

		<!-- Floating Action Buttons -->
		<div class="fixed bottom-6 right-6 z-50 flex flex-col gap-3">
			<!-- WhatsApp Button -->
			<a href="https://wa.me/14374329595" target="_blank" rel="noopener noreferrer" class="w-14 h-14 bg-slate-900 text-white flex items-center justify-center shadow-xl hover:bg-accent hover:text-white transition-all duration-300 hover:-translate-y-1 border border-slate-700 hover:border-accent" aria-label="Chat on WhatsApp">
				<svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 0C5.385 0 .001 5.384.001 12.031c0 2.12.553 4.195 1.603 6.012L.001 24l6.115-1.604a11.97 11.97 0 005.915 1.564h.005c6.645 0 12.03-5.384 12.03-12.031C24.066 5.384 18.675 0 12.031 0zm0 21.966c-1.796 0-3.553-.483-5.097-1.396l-.365-.216-3.791.993.993-3.697-.237-.377A9.972 9.972 0 012.001 12.03c0-5.541 4.49-10.03 10.03-10.03 5.539 0 10.029 4.489 10.029 10.03 0 5.542-4.49 10.032-10.03 10.036z"/><path d="M17.534 14.18c-.274-.138-1.623-.801-1.874-.894-.251-.091-.433-.138-.616.138-.182.274-.707.893-.867 1.076-.16.183-.32.206-.594.069-.274-.138-1.157-.427-2.204-1.36-.814-.725-1.365-1.621-1.524-1.895-.16-.275-.017-.424.12-.562.124-.124.275-.32.413-.481.137-.16.183-.274.275-.457.091-.183.045-.343-.023-.48-.069-.138-.616-1.488-.844-2.037-.221-.532-.446-.46-.616-.469-.16-.008-.344-.009-.527-.009-.183 0-.48.069-.731.344-.251.274-.96 .938-.96 2.287s.983 2.653 1.12 2.836c.137.183 1.933 2.952 4.681 4.136.654.282 1.165.45 1.564.576.655.207 1.25.178 1.716.108.523-.079 1.623-.663 1.851-1.305.228-.642.228-1.192.16-1.305-.068-.114-.25-.183-.524-.32z"/></svg>
			</a>
			<!-- Call Button -->
			<a href="tel:+14374329595" class="w-14 h-14 bg-accent text-white flex items-center justify-center shadow-xl hover:bg-slate-900 hover:text-accent transition-all duration-300 hover:-translate-y-1 border border-accent hover:border-slate-700" aria-label="Call Torvix">
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
			</a>
		</div>
	</body>
</html>
